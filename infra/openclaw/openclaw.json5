{
  gateway: {
    mode: "local",
    port: 18789,
    bind: "loopback",
  },
  agents: {
    defaults: {
      modelPolicy: {
        allow: [
          "opencode-go/kimi-k3",
          "opencode-go/deepseek-v4-pro",
          "integritas-openrouter/deepseek/deepseek-v4.1-flash",
          "integritas-openrouter/z-ai/glm-5.3",
          "integritas-openrouter/z-ai/glm-5.3-flash",
          "integritas-openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
          "integritas-openrouter/openrouter/free",
          "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
          "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
        ],
      },
      sandbox: {
        mode: "all",
        backend: "docker",
        scope: "session",
        workspaceAccess: "none",
        docker: {
          image: "openclaw-sandbox:bookworm-slim",
          network: "none",
          readOnlyRoot: true,
          capDrop: ["ALL"],
          pidsLimit: 256,
          memory: "1g",
          memorySwap: "2g",
          cpus: 1,
          tmpfs: ["/tmp", "/var/tmp", "/run"],
        },
        browser: {
          enabled: true,
          image: "openclaw-sandbox-browser:bookworm-slim",
          network: "openclaw-sandbox-browser",
          headless: true,
          noVncEnabled: false,
          allowHostControl: false,
          autoStart: true,
        },
        prune: {
          idleHours: 24,
          maxAgeDays: 7,
        },
      },
    },
  },
  skills: {
    load: { watch: true },
  },
  browser: {
    enabled: true,
    defaultProfile: "openclaw",
    headless: true,
  },
  tools: {
    profile: "coding",
    alsoAllow: ["browser"],
    elevated: { enabled: false },
    sessions: { visibility: "tree" },
    agentToAgent: { enabled: false },
    deny: ["gateway", "nodes"],
    sandbox: {
      tools: { alsoAllow: ["browser"] },
    },
  },
}
