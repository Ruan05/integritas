{
  $include: "./openclaw.json",
  models: {
    mode: "merge",
    providers: {
      "integritas-groq": {
        baseUrl: "https://api.groq.com/openai/v1",
        apiKey: { source: "env", provider: "default", id: "GROQ_API_KEY" },
        api: "openai-completions",
        authHeader: true,
        timeoutSeconds: 60,
        models: [
          {
            id: "openai/gpt-oss-20b",
            name: "Integritas Groq GPT-OSS 20B",
            reasoning: true,
            input: ["text"],
            cost: { input: 0.075, output: 0.30, cacheRead: 0.037, cacheWrite: 0 },
            contextWindow: 131072,
            contextTokens: 120000,
            maxTokens: 8192,
          },
          {
            id: "openai/gpt-oss-120b",
            name: "Integritas Groq GPT-OSS 120B",
            reasoning: true,
            input: ["text"],
            cost: { input: 0.15, output: 0.60, cacheRead: 0.075, cacheWrite: 0 },
            contextWindow: 131072,
            contextTokens: 120000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      sandbox: {
        workspaceAccess: "ro",
      },
      models: {
        "nvidia/nvidia/nemotron-3-ultra-550b-a55b": {
          params: {
            chat_template_kwargs: {
              enable_thinking: false,
              force_nonempty_content: true,
            },
          },
        },
      },
    },
  },
  tools: {
    profile: "minimal",
    alsoAllow: ["ls", "read", "web_search", "web_fetch", "browser", "view_image", "pdf"],
    deny: ["write", "edit", "exec", "apply_patch", "process", "code_execution", "terminal", "screen", "dashboard", "portal", "sessions", "sessions_list", "sessions_history", "sessions_search", "sessions_send", "sessions_spawn", "subagents", "secrets"],
  },
}
