{
  $include: "./openclaw.json",
  models: {
    mode: "merge",
    providers: {
      "integritas-openrouter": {
        baseUrl: "https://openrouter.ai/api/v1",
        apiKey: { source: "env", provider: "default", id: "OPENROUTER_API_KEY" },
        api: "openai-completions",
        authHeader: true,
        timeoutSeconds: 90,
        headers: {
          "HTTP-Referer": "https://integritass.com",
          "X-Title": "Integritas",
        },
        models: [
          {
            id: "deepseek/deepseek-v4.1-flash",
            name: "Integritas DeepSeek V4.1 Flash",
            reasoning: true,
            input: ["text", "image"],
            cost: { input: 0.15, output: 0.60, cacheRead: 0.015, cacheWrite: 0 },
            contextWindow: 1048576,
            contextTokens: 1000000,
            maxTokens: 131072,
          },
          {
            id: "z-ai/glm-5.3",
            name: "Integritas GLM 5.3",
            reasoning: true,
            input: ["text"],
            cost: { input: 0.90, output: 2.90, cacheRead: 0.17, cacheWrite: 0 },
            contextWindow: 1310720,
            contextTokens: 1200000,
            maxTokens: 131072,
          },
          {
            id: "z-ai/glm-5.3-flash",
            name: "Integritas GLM 5.3 Flash",
            reasoning: true,
            input: ["text", "image"],
            cost: { input: 0.075, output: 0.25, cacheRead: 0.015, cacheWrite: 0 },
            contextWindow: 1310720,
            contextTokens: 1200000,
            maxTokens: 131072,
          },
          {
            id: "nvidia/nemotron-3-ultra-550b-a55b:free",
            name: "Integritas OpenRouter Free Nemotron 3 Ultra",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 1048576,
            contextTokens: 1000000,
            maxTokens: 65536,
          },
          {
            id: "openrouter/free",
            name: "Integritas OpenRouter Dynamic Free Router",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            contextTokens: 180000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      modelPolicy: {
        allow: [
          "opencode-go/kimi-k3",
          "opencode-go/deepseek-v4-pro",
          "integritas-openrouter/deepseek/deepseek-v4.1-flash",
          "integritas-openrouter/z-ai/glm-5.3",
          "integritas-openrouter/z-ai/glm-5.3-flash",
          "integritas-openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
          "integritas-openrouter/openrouter/free",
          "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
          "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b",
        ],
      },
      sandbox: {
        workspaceAccess: "ro",
      },
      models: {
        "integritas-openrouter/deepseek/deepseek-v4.1-flash": {},
        "integritas-openrouter/z-ai/glm-5.3": {},
        "integritas-openrouter/z-ai/glm-5.3-flash": {},
        "integritas-openrouter/nvidia/nemotron-3-ultra-550b-a55b:free": {},
        "integritas-openrouter/openrouter/free": {},
        "nvidia/nvidia/nemotron-3-ultra-550b-a55b": {
          params: {
            maxTokens: 32768,
            chat_template_kwargs: {
              enable_thinking: false,
              force_nonempty_content: true,
            },
          },
        },
        "nvidia/nvidia/nemotron-3.5-lightning-30b-a3b": {
          params: {
            maxTokens: 16384,
            chat_template_kwargs: {
              enable_thinking: false,
              force_nonempty_content: true,
            },
          },
        },
      },
    },
  },
  tools: {
    profile: "minimal",
    alsoAllow: ["ls", "read", "web_search", "web_fetch", "browser", "view_image", "pdf"],
    deny: ["write", "edit", "exec", "apply_patch", "process", "code_execution", "terminal", "screen", "dashboard", "portal", "sessions", "sessions_list", "sessions_history", "sessions_search", "sessions_send", "sessions_spawn", "subagents", "secrets"],
  },
}
