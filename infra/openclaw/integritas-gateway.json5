{
  $include: "./openclaw.json",
  models: {
    mode: "merge",
    providers: {
      "integritas-groq": {
        baseUrl: "https://api.groq.com/openai/v1",
        apiKey: { source: "env", provider: "default", id: "GROQ_API_KEY" },
        api: "openai-completions",
        authHeader: true,
        timeoutSeconds: 60,
        models: [
          {
            id: "openai/gpt-oss-20b",
            name: "Integritas Groq GPT-OSS 20B",
            reasoning: true,
            input: ["text"],
            cost: { input: 0.075, output: 0.30, cacheRead: 0.037, cacheWrite: 0 },
            contextWindow: 131072,
            contextTokens: 120000,
            maxTokens: 8192,
          },
          {
            id: "openai/gpt-oss-120b",
            name: "Integritas Groq GPT-OSS 120B",
            reasoning: true,
            input: ["text"],
            cost: { input: 0.15, output: 0.60, cacheRead: 0.075, cacheWrite: 0 },
            contextWindow: 131072,
            contextTokens: 120000,
            maxTokens: 8192,
          },
        ],
      },
      "integritas-openrouter": {
        baseUrl: "https://openrouter.ai/api/v1",
        apiKey: { source: "env", provider: "default", id: "OPENROUTER_API_KEY" },
        api: "openai-completions",
        authHeader: true,
        timeoutSeconds: 90,
        headers: {
          "HTTP-Referer": "https://integritass.com",
          "X-Title": "Integritas",
        },
        models: [
          {
            id: "nvidia/nemotron-3-ultra-550b-a55b:free",
            name: "Integritas OpenRouter Free Nemotron 3 Ultra",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 1048576,
            contextTokens: 1000000,
            maxTokens: 8192,
          },
          {
            id: "openrouter/free",
            name: "Integritas OpenRouter Dynamic Free Router",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            contextTokens: 180000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: {
        primary: "nvidia/nemotron-3-ultra-550b-a55b",
        fallbacks: [
          "integritas-openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
          "integritas-openrouter/openrouter/free",
          "opencode-go/glm-5.3-flash",
        ],
      },
      models: {
        "integritas-groq/openai/gpt-oss-20b": {},
        "integritas-groq/openai/gpt-oss-120b": {},
        "integritas-openrouter/nvidia/nemotron-3-ultra-550b-a55b:free": {},
        "integritas-openrouter/openrouter/free": {},
        "opencode-go/glm-5.3-flash": {},
        "opencode-go/glm-5.2": {},
        "nvidia/nemotron-3-ultra-550b-a55b": {
          params: {
            chat_template_kwargs: {
              enable_thinking: false,
              force_nonempty_content: true,
            },
          },
        },
      },
    },
  },
}
