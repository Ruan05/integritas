{
  $include: "./openclaw.json",
  models: {
    mode: "merge",
    providers: {
      "integritas-openrouter": {
        baseUrl: "https://openrouter.ai/api/v1",
        apiKey: { source: "env", provider: "default", id: "OPENROUTER_API_KEY" },
        api: "openai-completions",
        authHeader: true,
        timeoutSeconds: 90,
        headers: {
          "HTTP-Referer": "https://integritass.com",
          "X-Title": "Integritas",
        },
        models: [
          {
            id: "nvidia/nemotron-3-ultra-550b-a55b:free",
            name: "Integritas OpenRouter Free Nemotron 3 Ultra",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 1048576,
            contextTokens: 1000000,
            maxTokens: 8192,
          },
          {
            id: "openrouter/free",
            name: "Integritas OpenRouter Dynamic Free Router",
            reasoning: true,
            input: ["text"],
            cost: { input: 0, output: 0, cacheRead: 0, cacheWrite: 0 },
            contextWindow: 200000,
            contextTokens: 180000,
            maxTokens: 8192,
          },
        ],
      },
    },
  },
  agents: {
    defaults: {
      model: {
        primary: "nvidia/nvidia/nemotron-3-ultra-550b-a55b",
        fallbacks: [
          "integritas-openrouter/nvidia/nemotron-3-ultra-550b-a55b:free",
          "integritas-openrouter/openrouter/free",
        ],
      },
      models: {
        "integritas-openrouter/nvidia/nemotron-3-ultra-550b-a55b:free": {},
        "integritas-openrouter/openrouter/free": {},
        "nvidia/nvidia/nemotron-3-ultra-550b-a55b": {
          params: {
            chat_template_kwargs: {
              enable_thinking: false,
              force_nonempty_content: true,
            },
          },
        },
      },
    },
  },
  memory: {
    search: {
      enabled: true,
      provider: "openai-compatible",
      model: "nvidia/nemotron-3-embed-1b",
      sources: ["memory", "sessions"],
      experimental: { sessionMemory: true },
      remote: {
        baseUrl: "https://integrate.api.nvidia.com/v1",
        apiKey: { source: "env", provider: "default", id: "NVIDIA_API_KEY" },
      },
      queryInputType: "query",
      documentInputType: "passage",
      fallback: "none",
      rememberAcrossConversations: true,
    },
  },
  // The operator Gateway uses the same key-free Parallel Search path already
  // proven by the isolated investigation runner. parallel-free must be selected
  // explicitly; OpenClaw intentionally does not auto-select key-free providers.
  plugins: {
    load: { paths: ["/opt/openclaw-source/extensions/parallel"] },
    entries: {
      parallel: { enabled: true },
      "active-memory": {
        enabled: true,
        config: {
          enabled: true,
          mode: "escalate",
          agents: ["main", "personal-admin"],
          allowedChatTypes: ["direct", "explicit"],
          queryMode: "recent",
          promptStyle: "balanced",
          timeoutMs: 12000,
          maxSummaryChars: 220,
          persistTranscripts: false,
          logging: false,
        },
      },
      "memory-core": {
        config: {
          dreaming: { enabled: true },
        },
      },
    },
  },
  tools: {
    web: {
      search: {
        enabled: true,
        provider: "parallel-free",
        maxResults: 8,
        timeoutSeconds: 45,
      },
      fetch: { enabled: true },
    },
  },
}
